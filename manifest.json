{
  "manifest_version": 3,
  "name": "Audio Bitrate Probe",
  "version": "0.7.0",
  "description": "Monitor real-time MSE & Direct audio bitrate, Dynamic Range, and parallel FFT (Lin/Log) + Spek Waterfall spectrograms.",
  "permissions": ["storage", "tabCapture", "offscreen", "activeTab", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Audio Bitrate Probe v0.7",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject_main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}